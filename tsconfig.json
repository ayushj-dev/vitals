{
	"extends": "./tsconfig.base.json",
	"include": [
		"packages/*/src/**/*.ts",
		"packages/*/test/**/*.ts",
		"packages/adaptors/*/src/**/*.ts",
		"packages/adaptors/*/test/**/*.ts"
	],
	// Browser code, checked by its own tsconfig which supplies the DOM lib.
	"exclude": ["packages/ui"],
	"compilerOptions": {
		"noEmit": true
	}
}
