{
	"name": "@vitals/monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Monorepo for Vitals - Lightweight, zero-dependency, real-time monitoring for Node.js servers.",
	"license": "MIT",
	"author": "Ayush Jain",
	"homepage": "https://github.com/ayushj-dev/vitals#readme",
	"bugs": {
		"url": "https://github.com/ayushj-dev/vitals/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ayushj-dev/vitals.git"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"lint": "biome check .",
		"typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @vitals/ui run typecheck",
		"test": "vitest run",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@changesets/cli": "^2.29.5",
		"@types/node": "^26.1.2",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
